rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && myProfile().role == 'admin';
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'employee'
        && request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // تغییر نقش فقط از کنسول Firebase توسط مالک پروژه انجام شود.
      allow update, delete: if false;
    }

    match /breakSessions/{sessionId} {
      allow read: if signedIn()
        && (isAdmin() || resource.data.employeeUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.plannedMinutes is int
        && request.resource.data.plannedMinutes >= 1
        && request.resource.data.plannedMinutes <= 60
        && request.resource.data.endAt == null;

      // کارمند فقط می‌تواند جلسه‌ی خودش را از active به completed ببرد.
      allow update: if signedIn()
        && resource.data.employeeUid == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.employeeUid == resource.data.employeeUid
        && request.resource.data.employeeEmail == resource.data.employeeEmail
        && request.resource.data.employeeName == resource.data.employeeName
        && request.resource.data.plannedMinutes == resource.data.plannedMinutes
        && request.resource.data.startAt == resource.data.startAt
        && request.resource.data.startAtClient == resource.data.startAtClient
        && request.resource.data.status == 'completed'
        && request.resource.data.endAt != null;

      allow delete: if isAdmin();
    }
  }
}